# Database (local PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=bookseva
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=

# To use MySQL instead, add the MySQL Connector/J dependency to pom.xml, then
# replace DB_URL and DB_DRIVER above with these values:
# DB_URL=jdbc:mysql://localhost:3306/bookseva?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Spring AI (optional)
SPRING_AI_API_KEY=

# App config
ALLOWED_EMAIL_DOMAINS= # leave empty = any email accepted (current setting)
FRONTEND_ORIGIN=http://localhost:5173
PLATFORM_FEE_PERCENT=0
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
