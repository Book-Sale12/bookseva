# Database (local MySQL)
DB_URL=jdbc:mysql://localhost:3306/bookseva
DB_USERNAME=bookseva_user
DB_PASSWORD=

# JWT
JWT_SECRET= # generate any long random string, e.g. `openssl rand -hex 32`
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Spring AI (optional)
SPRING_AI_API_KEY=

# App config
ALLOWED_EMAIL_DOMAINS= # leave empty = any email accepted (current setting)
FRONTEND_ORIGIN=http://localhost:5173
PLATFORM_FEE_PERCENT=0
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
